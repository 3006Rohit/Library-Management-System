public with sharing class LibraryLibrarianController {
    public class DashboardData { @AuraEnabled public Integer totalBooks; @AuraEnabled public Integer totalCopies; @AuraEnabled public Integer availableCopies; @AuraEnabled public Integer borrowedCopies; @AuraEnabled public Integer activeMembers; @AuraEnabled public Integer pendingRegistrations; @AuraEnabled public Integer activeLoans; @AuraEnabled public Integer overdueLoans; @AuraEnabled public Integer pendingReservations; @AuraEnabled public Integer unpaidFines; @AuraEnabled public List<Borrow_Record__c> recentLoans; @AuraEnabled public List<Library_Registration__c> registrations; @AuraEnabled public List<Reservation__c> readyReservations; }
    public class MemberDetail { @AuraEnabled public Member__c member; @AuraEnabled public List<Borrow_Record__c> loans; @AuraEnabled public List<Reservation__c> reservations; @AuraEnabled public List<Fine__c> fines; @AuraEnabled public Decimal outstandingBalance; }
    @AuraEnabled(cacheable=true) public static DashboardData getDashboard() { LibraryPolicyService.require('Manage_Library_Circulation'); DashboardData d=new DashboardData(); d.totalBooks=[SELECT count() FROM Book__c]; d.totalCopies=[SELECT count() FROM Book_Copy__c]; d.availableCopies=[SELECT count() FROM Book_Copy__c WHERE Status__c='Available']; d.borrowedCopies=[SELECT count() FROM Book_Copy__c WHERE Status__c='Borrowed']; d.activeMembers=[SELECT count() FROM Member__c WHERE Status__c='Active' AND Membership_End_Date__c >= :Date.today()]; d.pendingRegistrations=[SELECT count() FROM Library_Registration__c WHERE Status__c='Pending']; d.activeLoans=[SELECT count() FROM Borrow_Record__c WHERE Return_Date__c=null AND Status__c IN ('Active','Overdue')]; d.overdueLoans=[SELECT count() FROM Borrow_Record__c WHERE Return_Date__c=null AND Due_Date__c < :System.now()]; d.pendingReservations=[SELECT count() FROM Reservation__c WHERE Status__c='Pending']; d.unpaidFines=[SELECT count() FROM Fine__c WHERE Status__c IN ('Unpaid','Partially Paid')]; d.recentLoans=[SELECT Id,Name,Member__r.Name,Book_Copy__r.Name,Borrow_Date__c,Due_Date__c,Status__c FROM Borrow_Record__c ORDER BY Borrow_Date__c DESC LIMIT 10]; d.registrations=[SELECT Id,Name,First_Name__c,Last_Name__c,Email__c,Requested_Plan__r.Name,Registration_Date__c,Status__c,Provisioning_State__c FROM Library_Registration__c WHERE Status__c='Pending' ORDER BY Registration_Date__c ASC LIMIT 10]; d.readyReservations=[SELECT Id,Name,Member__r.Name,Book__r.Name,Ready_Date__c,Expiry_Date__c FROM Reservation__c WHERE Status__c='Ready' ORDER BY Ready_Date__c ASC LIMIT 10]; return d; }
    @AuraEnabled(cacheable=true) public static List<Book__c> searchBooks(String searchTerm, String categoryId, String status, Integer pageSize, Integer pageNumber) { LibraryPolicyService.require('Manage_Library_Catalog'); Integer size=pageSize == null || pageSize < 1 || pageSize > 100 ? 25 : pageSize; Integer offsetValue=pageNumber == null || pageNumber < 1 ? 0 : (pageNumber-1)*size; String term=String.isBlank(searchTerm) ? null : '%'+searchTerm.trim()+'%'; String q='SELECT Id,Name,ISBN__c,Publisher__c,Publication_Year__c,Edition__c,Language__c,Total_Copies__c,Available_Copies__c,Status__c,(SELECT Author__r.Name FROM Book_Authors__r),(SELECT Book_Category__r.Name FROM Book_Category_Links__r) FROM Book__c'; List<String> clauses=new List<String>(); if(term!=null) clauses.add('(Name LIKE :term OR ISBN__c LIKE :term OR Publisher__c LIKE :term)'); if(!String.isBlank(status)) clauses.add('Status__c=:status'); if(!String.isBlank(categoryId)) clauses.add('Id IN (SELECT Book__c FROM Book_Category_Link__c WHERE Book_Category__c=:categoryId)'); if(!clauses.isEmpty()) q+=' WHERE '+String.join(clauses,' AND '); q+=' ORDER BY Name LIMIT :size OFFSET :offsetValue'; return Database.query(q); }
    @AuraEnabled(cacheable=true) public static List<Author__c> getAuthors() { LibraryPolicyService.require('Manage_Library_Catalog'); return [SELECT Id,Name FROM Author__c ORDER BY Name LIMIT 500]; }
    @AuraEnabled(cacheable=true) public static List<Book_Category__c> getCategories() { LibraryPolicyService.require('Manage_Library_Catalog'); return [SELECT Id,Name FROM Book_Category__c WHERE Active__c=true ORDER BY Name LIMIT 500]; }
    @AuraEnabled(cacheable=true) public static Book__c getBookDetail(Id bookId) { LibraryPolicyService.require('Manage_Library_Catalog'); return [SELECT Id,Name,ISBN__c,Publisher__c,Publication_Year__c,Edition__c,Language__c,Description__c,Cover_Image_URL__c,Total_Copies__c,Available_Copies__c,Status__c,(SELECT Id,Author__c,Author__r.Name FROM Book_Authors__r),(SELECT Id,Book_Category__c,Book_Category__r.Name FROM Book_Category_Links__r),(SELECT Id,Name,Barcode__c,Status__c,Shelf_Location__c,Acquisition_Date__c,Condition__c,Price__c FROM Book_Copies__r ORDER BY Name) FROM Book__c WHERE Id=:bookId]; }
    @AuraEnabled(cacheable=true) public static List<Member__c> searchMembers(String searchTerm, String status) { LibraryPolicyService.require('Manage_Library_Circulation'); String term=String.isBlank(searchTerm)?null:'%'+searchTerm.trim()+'%'; String q='SELECT Id,Name,First_Name__c,Last_Name__c,Email__c,Phone__c,Membership_Plan__r.Name,Membership_Start_Date__c,Membership_End_Date__c,Status__c FROM Member__c'; List<String> clauses=new List<String>(); if(term!=null) clauses.add('(Name LIKE :term OR First_Name__c LIKE :term OR Last_Name__c LIKE :term OR Email__c LIKE :term OR Phone__c LIKE :term)'); if(!String.isBlank(status)) clauses.add('Status__c=:status'); if(!clauses.isEmpty()) q+=' WHERE '+String.join(clauses,' AND '); q+=' ORDER BY Last_Name__c LIMIT 100'; return Database.query(q); }
    @AuraEnabled(cacheable=true) public static List<Book_Copy__c> getAvailableCopies(Id bookId) { LibraryPolicyService.require('Manage_Library_Circulation'); return [SELECT Id,Name,Barcode__c,Status__c,Shelf_Location__c,Condition__c,Book__r.Name FROM Book_Copy__c WHERE Book__c=:bookId AND Status__c='Available' ORDER BY Name LIMIT 100]; }
    @AuraEnabled(cacheable=true) public static List<Book_Copy__c> searchCopies(String searchTerm,String status,Id bookId,Integer pageSize,Integer pageNumber) { LibraryPolicyService.require('Manage_Library_Circulation'); Integer size=pageSize; if(size==null||size<1||size>50) size=11; Integer off=0; if(pageNumber!=null&&pageNumber>1) off=(pageNumber-1)*10; String term=String.isBlank(searchTerm)?null:'%'+searchTerm.trim()+'%'; String q='SELECT Id,Name,Barcode__c,Status__c,Shelf_Location__c,Condition__c,Acquisition_Date__c,Price__c,Book__c,Book__r.Name FROM Book_Copy__c'; List<String> clauses=new List<String>(); if(term!=null) clauses.add('(Name LIKE :term OR Barcode__c LIKE :term OR Book__r.Name LIKE :term)'); if(!String.isBlank(status)) clauses.add('Status__c=:status'); if(bookId!=null) clauses.add('Book__c=:bookId'); if(!clauses.isEmpty()) q+=' WHERE '+String.join(clauses,' AND '); q+=' ORDER BY Name LIMIT :size OFFSET :off'; return Database.query(q); }
    @AuraEnabled public static Id addBook(String title,String isbn,String publisher,Decimal publicationYear,String edition,String language,String description,String coverUrl,List<Id> authorIds,List<Id> categoryIds){return LibraryCatalogService.addBook(title,isbn,publisher,publicationYear,edition,language,description,coverUrl,authorIds,categoryIds);}
    @AuraEnabled public static void updateBook(Id bookId,String title,String isbn,String publisher,Decimal publicationYear,String edition,String language,String description,String coverUrl,List<Id> authorIds,List<Id> categoryIds){LibraryCatalogService.updateBook(bookId,title,isbn,publisher,publicationYear,edition,language,description,coverUrl,authorIds,categoryIds);}
    @AuraEnabled public static Id addCopy(Id bookId,String barcode,String shelf,Date acquisitionDate,String condition,Decimal price){return LibraryCatalogService.addCopy(bookId,barcode,shelf,acquisitionDate,condition,price);}
    @AuraEnabled public static void updateCopy(Id copyId,String shelf,Date acquisitionDate,String condition,Decimal price,String status){LibraryCatalogService.updateCopy(copyId,shelf,acquisitionDate,condition,price,status);}
    @AuraEnabled public static void retireCopy(Id copyId){LibraryCatalogService.retireCopy(copyId);}
    @AuraEnabled(cacheable=true) public static List<Book_Copy__c> getBookCopies(Id bookId){LibraryPolicyService.require('Manage_Library_Catalog');return [SELECT Id,Name,Barcode__c,Status__c,Shelf_Location__c,Acquisition_Date__c,Condition__c,Price__c FROM Book_Copy__c WHERE Book__c=:bookId ORDER BY Name LIMIT 200];}
    public static List<Library_Registration__c> getRegistrations(){return getRegistrations(null);}
    @AuraEnabled(cacheable=true) public static List<Library_Registration__c> getRegistrations(String status){LibraryPolicyService.require('Manage_Library_Registrations');String q='SELECT Id,Name,First_Name__c,Last_Name__c,Email__c,Phone__c,Requested_Plan__r.Name,Registration_Date__c,Status__c,Provisioning_State__c FROM Library_Registration__c';if(!String.isBlank(status))q+=' WHERE Status__c=:status';q+=' ORDER BY Registration_Date__c DESC LIMIT 200';return Database.query(q);}
    @AuraEnabled public static void approveRegistration(Id registrationId){LibraryRegistrationController.approveRegistration(registrationId);}
    @AuraEnabled public static void rejectRegistration(Id registrationId,String reason){LibraryRegistrationController.rejectRegistration(registrationId,reason);}
    @AuraEnabled public static void retryProvisioning(Id registrationId){LibraryRegistrationController.retryProvisioning(registrationId);}
    public static List<Reservation__c> getReservations(){return getReservations(null);}
    @AuraEnabled(cacheable=true) public static List<Reservation__c> getReservations(String status){LibraryPolicyService.require('Manage_Library_Circulation');String q='SELECT Id,Name,Member__r.Name,Book__r.Name,Book_Copy__r.Name,Reservation_Date__c,Queue_Position__c,Status__c,Ready_Date__c,Expiry_Date__c,Fulfilled_Date__c FROM Reservation__c';if(!String.isBlank(status))q+=' WHERE Status__c=:status';q+=' ORDER BY Reservation_Date__c DESC LIMIT 200';return Database.query(q);}
    public static List<Fine__c> getFines(){return getFines(null);}
    @AuraEnabled(cacheable=true) public static List<Fine__c> getFines(String status){LibraryPolicyService.require('Manage_Library_Fines');String q='SELECT Id,Name,Member__r.Name,Borrow_Record__r.Name,Fine_Type__c,Amount__c,Paid_Amount__c,Balance__c,Status__c,Generated_Date__c,Paid_Date__c FROM Fine__c';if(!String.isBlank(status))q+=' WHERE Status__c=:status';q+=' ORDER BY Generated_Date__c DESC LIMIT 200';return Database.query(q);}
    @AuraEnabled(cacheable=true) public static MemberDetail getMemberDetail(Id memberId){LibraryPolicyService.require('Manage_Library_Circulation');MemberDetail d=new MemberDetail();d.member=[SELECT Id,Name,First_Name__c,Last_Name__c,Email__c,Phone__c,Membership_Plan__r.Name,Membership_Start_Date__c,Membership_End_Date__c,Status__c FROM Member__c WHERE Id=:memberId];d.loans=[SELECT Id,Name,Book_Copy__r.Name,Book_Copy__r.Book__r.Name,Borrow_Date__c,Due_Date__c,Return_Date__c,Status__c,Renewal_Count__c FROM Borrow_Record__c WHERE Member__c=:memberId ORDER BY Borrow_Date__c DESC LIMIT 100];d.reservations=[SELECT Id,Name,Book__r.Name,Status__c,Reservation_Date__c,Queue_Position__c,Ready_Date__c,Expiry_Date__c,Fulfilled_Date__c FROM Reservation__c WHERE Member__c=:memberId ORDER BY Reservation_Date__c DESC LIMIT 100];d.fines=[SELECT Id,Name,Fine_Type__c,Amount__c,Paid_Amount__c,Balance__c,Status__c,Generated_Date__c FROM Fine__c WHERE Member__c=:memberId ORDER BY Generated_Date__c DESC LIMIT 100];d.outstandingBalance=0;for(Fine__c f:d.fines)if(f.Status__c=='Unpaid'||f.Status__c=='Partially Paid')d.outstandingBalance+=(f.Balance__c==null?0:f.Balance__c);return d;}
    @AuraEnabled public static Id checkout(Id memberId,Id copyId){return LibraryCirculationService.checkout(memberId,copyId);}@AuraEnabled public static void returnLoan(Id loanId){LibraryCirculationService.returnLoan(loanId);}@AuraEnabled public static void renewLoan(Id loanId){LibraryCirculationService.renewLoan(loanId);}@AuraEnabled public static void reportDefectiveCopy(Id loanId,String notes){LibraryCirculationService.reportDefectiveCopy(loanId,notes);}@AuraEnabled public static void replaceDefectiveCopy(Id loanId,Id replacementCopyId){LibraryCirculationService.replaceDefectiveCopy(loanId,replacementCopyId);}@AuraEnabled public static void recordFinePayment(Id fineId,Decimal amount){LibraryCirculationService.recordFinePayment(fineId,amount);}@AuraEnabled public static void waiveFine(Id fineId,String reason){LibraryCirculationService.waiveFine(fineId,reason);}
    @AuraEnabled public static Id createReservation(Id memberId,Id bookId){return LibraryCirculationService.createReservation(memberId,bookId);}@AuraEnabled public static void cancelReservation(Id reservationId){LibraryCirculationService.cancelReservation(reservationId);}@AuraEnabled public static Integer processExpiredReservations(){return LibraryCirculationService.processExpiredReservations();}
}
