<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Library Settings</label>
    <pluralLabel>Library Settings</pluralLabel>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <nameField>
        <label>Settings Name</label>
        <type>Text</type>
    </nameField>
    <fields><fullName>Settings_Key__c</fullName><label
    >Settings Key</label><length>40</length><type>Text</type><unique
    >true</unique><externalId>true</externalId></fields>
    <fields><fullName>Library_Name__c</fullName><label
    >Library Name</label><length>100</length><type>Text</type></fields>
    <fields><fullName>Contact_Email__c</fullName><label
    >Contact Email</label><type>Email</type></fields>
    <fields><fullName>Default_Shelf_Prefix__c</fullName><label
    >Default Shelf Prefix</label><length>20</length><type>Text</type></fields>
    <fields><fullName>Reservation_Hold_Days__c</fullName><label
    >Reservation Hold Days</label><defaultValue>3</defaultValue><precision
    >3</precision><scale>0</scale><type>Number</type></fields>
    <fields><fullName>Due_Reminder_Days__c</fullName><label
    >Due Reminder Days</label><defaultValue>3</defaultValue><precision
    >3</precision><scale>0</scale><type>Number</type></fields>
    <fields><fullName>Max_Search_Results__c</fullName><label
    >Maximum Search Results</label><defaultValue>200</defaultValue><precision
    >4</precision><scale>0</scale><type>Number</type></fields>
    <fields><fullName>Send_Due_Reminders__c</fullName><label
    >Send Due Reminders</label><defaultValue>true</defaultValue><type
    >Checkbox</type></fields>
    <fields><fullName>Send_Overdue_Notices__c</fullName><label
    >Send Overdue Notices</label><defaultValue>true</defaultValue><type
    >Checkbox</type></fields>
    <fields><fullName>Send_Reservation_Notifications__c</fullName><label
    >Send Reservation Notifications</label><defaultValue
    >true</defaultValue><type>Checkbox</type></fields>
    <fields><fullName>Allow_Self_Registration__c</fullName><label
    >Allow Self Registration</label><defaultValue>true</defaultValue><type
    >Checkbox</type></fields>
    <fields><fullName>Require_Email_Verification__c</fullName><label
    >Require Email Verification</label><defaultValue>true</defaultValue><type
    >Checkbox</type></fields>
    <fields><fullName>Auto_Process_Expired_Holds__c</fullName><label
    >Automatically Process Expired Holds</label><defaultValue
    >true</defaultValue><type>Checkbox</type></fields>
    <fields><fullName>Fine_Payment_Enabled__c</fullName><label
    >Fine Payment Enabled</label><defaultValue>true</defaultValue><type
    >Checkbox</type></fields>
    <validationRules><fullName>Positive_Operational_Values</fullName><active
    >true</active><errorConditionFormula
    >OR(Reservation_Hold_Days__c &lt; 1, Due_Reminder_Days__c &lt; 0, Max_Search_Results__c &lt; 10)</errorConditionFormula><errorMessage
    >Hold days must be at least 1, reminder days cannot be negative, and search results must be at least 10.</errorMessage></validationRules>
</CustomObject>
