<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata"><fullName
  >Expiry_After_Reservation_Date</fullName><active
  >true</active><errorConditionFormula
  >AND(NOT(ISBLANK(Reservation_Date__c)), NOT(ISBLANK(Expiry_Date__c)), Expiry_Date__c &lt; Reservation_Date__c)</errorConditionFormula><errorMessage
  >Reservation expiry cannot be before reservation date.</errorMessage></ValidationRule>
