        <allowRead>true</allowRead>
    </objectPermissions>
    <objectPermissions>
        <object>Book_Category__c</object>
        <allowRead>true</allowRead>
    </objectPermissions>
    <objectPermissions>
        <object>Book_Category_Link__c</object>
        <allowRead>true</allowRead>
    </objectPermissions>
    <objectPermissions>
        <object>Member__c</object>
        <allowRead>true</allowRead>
    </objectPermissions>
    <fieldPermissions>
