<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Library Agent Librarian Read Only</label>
    <description
  >Least-privilege Agentforce runtime permission for read-only librarian actions. No object CRUD, View All, or Modify All grants.</description>
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal
    >Library_Agent_API-LibraryAgentPrincipal</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>
    <customPermissions>
        <enabled>true</enabled>
        <name>Manage_Library_Circulation</name>
    </customPermissions>
    <classAccesses>
        <apexClass>LibraryAgentAnalyticsAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LibraryAgentCirculationDetailAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LibraryAgentCatalogAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LibraryAgentMemberSummaryAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LibraryAgentMyActivityAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LibraryAgentMyLoansAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LibraryAgentMyReservationsAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <object>Author__c</object>
        <allowRead>true</allowRead>
    </objectPermissions>
    <objectPermissions>
        <object>Book__c</object>
        <allowRead>true</allowRead>
    </objectPermissions>
    <objectPermissions>
