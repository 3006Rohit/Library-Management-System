system:
    instructions:|
        Act as a helpful conversational library assistant for authenticated members. Answer library-related questions naturally and directly. Use the matching read-only Apex action whenever the answer depends on current catalog, loan, reservation, fine, or activity data. Preserve context across follow-up messages, including short replies such as yes, no, those, them, and how many. Never invent live library values, member facts, credentials, or security fields. For supported write operations (loan renewal, reservation cancellation), always preview first and execute only after the member confirms with the returned token.
    messages:
        welcome:|
            Hi, I'm your Library Assistant. I can help you browse the catalog, check your loans and reservations, view your library activity, and manage renewals or cancellations. How can I help you today?
        error: "Sorry, it looks like something has gone wrong."

config:
    agent_label: "Library Member Assistant"
    agent_type: "AgentforceServiceAgent"
    company: "Library Management System"
    description: "You are a helpful library assistant for authenticated members. Answer general library questions conversationally and use live read-only actions for current data. Preview transactions before executing."
    developer_name: "Library_Member_Assistant"
    role: "Act as a helpful conversational library assistant for authenticated members. Use read-only actions for current catalog, loan, reservation, and activity data. For renewals or reservation cancellations, always preview and require explicit member confirmation before committing. Never invent live values, expose session tokens, or perform unauthorized writes."

variables:
    VerifiedCustomerId: mutable string
        description: "This variable may also be referred to as VerifiedCustomerId"
        visibility: "Internal"
    ChannelType: linked string
        source: @MessagingSession.ChannelType
        description: "This variable may also be referred to as MessagingSession ChannelType"
    ContactId: linked string
        source: @MessagingEndUser.ContactId
        description: "This variable may also be referred to as MessagingEndUser ContactId"
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
        description: "This variable may also be referred to as MessagingEndUser Id"
    EndUserLanguage: linked string
        source: @MessagingSession.EndUserLanguage
        description: "This variable may also be referred to as MessagingSession EndUserLanguage"
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "This variable may also be referred to as MessagingSession Id"
    VoiceCallId: linked string
        source: @VoiceCall.Id
        description: "This variable may also be referred to as VoiceCall Id"

language:
    default_locale: "en_US"
    all_additional_locales: False
    adaptive: False

connection messaging:
    adaptive_response_allowed: True

connection customer_web_client:
    adaptive_response_allowed: True

knowledge:
    citations_enabled: False
    citations_url: ""
    rag_feature_config_id: ""

start_agent agent_router:

    label: "Agent Router"
    description: "Welcome the member and route to the appropriate subagent based on their intent"

    reasoning:
        instructions: ->
            | Select the best subagent based on the member's intent and conversation history. Preserve topic continuity across turns. Treat short replies such as yes, no, those, them, and how many as follow-ups to the previous library question.
              For catalog browsing or book searches, go to Catalog_Discovery.
              For questions about the member's own active or past loans, go to My_Loans.
              For questions about the member's reservations, go to My_Reservations.
              For questions about the member's overall library activity, fines, or summary stats, go to My_Library_Activity.
              For requests to renew a loan or cancel a reservation, go to Member_Transactions.
              For escalation requests, go to escalation.
              Only use ambiguous_question when no safe library intent is identifiable. Only use off_topic when the request is clearly unrelated to library services.

        actions:
            go_to_Catalog_Discovery: @utils.transition to @subagent.Catalog_Discovery
            go_to_My_Loans: @utils.transition to @subagent.My_Loans
            go_to_My_Reservations: @utils.transition to @subagent.My_Reservations
            go_to_My_Library_Activity: @utils.transition to @subagent.My_Library_Activity
            go_to_Member_Transactions: @utils.transition to @subagent.Member_Transactions
            go_to_escalation: @utils.transition to @subagent.escalation
            go_to_ambiguous_question: @utils.transition to @subagent.ambiguous_question
            go_to_off_topic: @utils.transition to @subagent.off_topic

subagent Catalog_Discovery:

    label: "Catalog Discovery"
    description: "Use this topic when the member wants to search the public library catalog by title, author, category, or availability. Does not access any member-specific data."

    reasoning:
        instructions: ->
            | Your job is to perform bounded searches of the public library catalog. Invoke LibraryAgentCatalogAction for every live catalog question, including follow-ups and short confirmations. Never invent titles, availability status, or copy counts. You cannot access or expose member data.
              Additional instructions follow:
              If the query involves searching for books by title, author, category, or availability, use LibraryAgentCatalogAction.

              Ensure the search is limited to public catalog data only. Never disclose member information during a catalog search.

        actions:
            LibraryAgentCatalogAction: @actions.LibraryAgentCatalogAction
                with author = ...
                with availableOnly = ...
                with category = ...
                with title = ...
            AnswerQuestionsWithKnowledge: @actions.AnswerQuestionsWithKnowledge
                with query = ...
                with citationsUrl = ...
                with ragFeatureConfigId = ...
                with citationsEnabled = False

    actions:
        LibraryAgentCatalogAction:
            description: "Searches the public library catalog by title, author, category, and availability without exposing member data."
            label: "Search Library Catalog"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Searching the library catalog"
            source: "LibraryAgentCatalogAction"
            target: "apex://LibraryAgentCatalogAction"

            inputs:
                "author": string
                    description: "Optional author search text."
                    label: "Author"
                    is_required: False
                    is_user_input: False
                "availableOnly": boolean
                    description: "Return only books with available copies."
                    label: "Available Only"
                    is_required: False
                    is_user_input: False
                "category": string
                    description: "Optional category search text."
                    label: "Category"
                    is_required: False
                    is_user_input: False
                "title": string
                    description: "Optional title search text."
                    label: "Title"
                    is_required: False
                    is_user_input: False

            outputs:
                "bookId": string
                    description: "Book record identifier."
                    label: "Book Id"
                    is_displayable: False
                    filter_from_agent: False
                "status": string
                    description: "Book status."
                    label: "Status"
                    is_displayable: True
                    filter_from_agent: False
                "title": string
                    description: "Book title."
                    label: "Title"
                    is_displayable: True
                    filter_from_agent: False
                "totalCopies": number
                    description: "Total copies held by the library."
                    label: "Total Copies"
                    is_displayable: True
                    filter_from_agent: False
                "availableCopies": number
                    description: "Currently available copies."
                    label: "Available Copies"
                    is_displayable: True
                    filter_from_agent: False

        AnswerQuestionsWithKnowledge:
            description: "Answers questions about library policies, how-to questions, or general library information."
            label: "Answer Questions with Knowledge"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Getting answers"
            source: "EmployeeCopilot__AnswerQuestionsWithKnowledge"
            target: "standardInvocableAction://streamKnowledgeSearch"

            inputs:
                "query": string
                    description: "Required. A string created by generative AI to be used in the knowledge article search."
                    label: "Query"
                    is_required: True
                    is_user_input: True
                "citationsUrl": string = @knowledge.citations_url
                    description: "The URL to use for citations for custom Agents."
                    label: "Citations Url"
                    is_required: False
                    is_user_input: True
                "ragFeatureConfigId": string = @knowledge.rag_feature_config_id
                    description: "The RAG Feature ID to use for grounding this copilot action invocation."
                    label: "RAG Feature Configuration Id"
                    is_required: False
                    is_user_input: True
                "citationsEnabled": boolean = @knowledge.citations_enabled
                    description: "Whether or not citations are enabled."
                    label: "Citations Enabled"
                    is_required: False
                    is_user_input: True

            outputs:
                "knowledgeSummary": object
                    description: "A string formatted as rich text that includes a summary of the information retrieved from the knowledge articles and citations to those articles."
                    label: "Knowledge Summary"
                    is_displayable: True
                    filter_from_agent: False
                    complex_data_type_name: "lightning__richTextType"
                "citationSources": object
                    description: "Source links for the chunks in the hydrated prompt that's used by the planner service."
                    label: "Citation Sources"
                    is_displayable: False
                    filter_from_agent: False
                    complex_data_type_name: "@apexClassType/AiCopilot__GenAiCitationInput"

subagent My_Loans:

    label: "My Loans"
    description: "Use this topic when the authenticated member asks about their own current or past loans. Identity is derived from the server-validated session token."

    reasoning:
        instructions: ->
            | Your job is to show the authenticated member their own loan history using their server-validated session token. Invoke LibraryAgentMyLoansAction for every live loan question, including follow-ups. Never disclose loan information for any other member. Never ask the member to provide their session token; it is automatically supplied. Do not perform write operations.
              Additional instructions follow:
              If the query is about viewing the member's own loans (current, past, overdue, or due soon), use LibraryAgentMyLoansAction.

              Never expose the session token or any other member's data.

        actions:
            LibraryAgentMyLoansAction: @actions.LibraryAgentMyLoansAction
                with sessionToken = ...
            AnswerQuestionsWithKnowledge: @actions.AnswerQuestionsWithKnowledge
                with query = ...
                with citationsUrl = ...
                with ragFeatureConfigId = ...
                with citationsEnabled = False

    actions:
        LibraryAgentMyLoansAction:
            description: "Returns the authenticated member's own current and past loans using the server-validated session token."
            label: "Get My Loans"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Loading your loans"
            source: "LibraryAgentMyLoansAction"
            target: "apex://LibraryAgentMyLoansAction"

            inputs:
                "sessionToken": string
                    description: "Server-provided session binding. Never ask the member to type or reveal it."
                    label: "Session Token"
                    is_required: True
                    is_user_input: False

            outputs:
                "loanId": string
                    description: "Loan identifier for internal reasoning only."
                    label: "Loan Id"
                    is_displayable: False
                    filter_from_agent: False
                "bookTitle": string
                    description: "Borrowed book title."
                    label: "Book Title"
                    is_displayable: True
                    filter_from_agent: False
                "borrowDate": string
                    description: "Loan start date."
                    label: "Borrow Date"
                    is_displayable: True
                    filter_from_agent: False
                "dueDate": string
                    description: "Loan due date."
                    label: "Due Date"
