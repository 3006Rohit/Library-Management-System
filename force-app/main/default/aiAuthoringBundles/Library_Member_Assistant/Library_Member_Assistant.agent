subagent Member_Transactions:

    label: "Member Transactions"
    description: "Use this topic when the authenticated member wants to renew a loan or cancel a reservation. Always preview the transaction and require explicit member confirmation before committing."

    reasoning:
        instructions: ->
            | Your job is to help the authenticated member renew a loan or cancel a reservation safely. Follow this two-step flow:
              Step 1 - PREVIEW: When the member requests an action, call LibraryAgentConfirmationAction with the action name (RENEW_LOAN or CANCEL_RESERVATION) and the target loan or reservation ID. Present the returned preview text to the member and ask them to confirm explicitly.
              Step 2 - EXECUTE: Only after the member confirms, call LibraryAgentConfirmationAction again with the same action, targetId, and the confirmationToken returned in Step 1. Report the outcome.
              Rules:
                Never commit a transaction without showing the preview and receiving explicit member confirmation.
                Never accept a confirmation token provided by the member; only use the token returned by the preview call.
                If the member declines, cancel and offer to help with something else.
                Never perform write operations other than loan renewals and reservation cancellations.
                The sessionToken is automatically derived; never ask the member for it.

        actions:
            LibraryAgentConfirmationAction: @actions.LibraryAgentConfirmationAction
                with sessionToken = ...
                with action = ...
                with targetId = ...
                with confirmationToken = ...
            LibraryAgentMyLoansAction: @actions.LibraryAgentMyLoansAction
                with sessionToken = ...
            LibraryAgentMyReservationsAction: @actions.LibraryAgentMyReservationsAction
                with sessionToken = ...

    actions:
        LibraryAgentConfirmationAction:
            description: "Previews or confirms a supported member transaction (loan renewal or reservation cancellation). Call without a confirmationToken to preview; call with the returned confirmationToken to execute."
            label: "Preview or Confirm Member Transaction"
            require_user_confirmation: True
            include_in_progress_indicator: True
            progress_indicator_message: "Processing your request"
            source: "LibraryAgentConfirmationAction"
            target: "apex://LibraryAgentConfirmationAction"

            inputs:
                "sessionToken": string
                    description: "Server-provided session binding. Never ask the member to type or reveal it."
                    label: "Session Token"
                    is_required: True
                    is_user_input: False
                "action": string
                    description: "The action to perform: RENEW_LOAN or CANCEL_RESERVATION."
                    label: "Action"
                    is_required: True
                    is_user_input: False
                "targetId": string
                    description: "The Salesforce record ID of the loan or reservation to act on."
                    label: "Target Id"
                    is_required: False
                    is_user_input: False
                "confirmationToken": string
                    description: "The single-use token returned by the preview step. Omit on preview calls; supply on execute calls only."
                    label: "Confirmation Token"
                    is_required: False
                    is_user_input: False

            outputs:
                "requiresConfirmation": boolean
                    description: "True when the preview is shown and member confirmation is required."
                    label: "Requires Confirmation"
                    is_displayable: True
                    filter_from_agent: False
                "confirmationToken": string
                    description: "Single-use token to pass back when the member confirms. Never reveal to the member."
                    label: "Confirmation Token"
                    is_displayable: False
                    filter_from_agent: False
                "preview": string
                    description: "Human-readable description of the action to be performed."
                    label: "Preview"
                    is_displayable: True
                    filter_from_agent: False
                "resultRecordId": string
                    description: "ID of the committed record on success."
                    label: "Result Record Id"
                    is_displayable: False
                    filter_from_agent: False
                "message": string
                    description: "Status or error message."
                    label: "Message"
                    is_displayable: True
                    filter_from_agent: False

        LibraryAgentMyLoansAction:
            description: "Returns the authenticated member's own current and past loans for context when selecting a loan to renew."
            label: "Get My Loans"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Loading your loans"
            source: "LibraryAgentMyLoansAction"
            target: "apex://LibraryAgentMyLoansAction"

            inputs:
                "sessionToken": string
                    description: "Server-provided session binding. Never ask the member to type or reveal it."
                    label: "Session Token"
                    is_required: True
                    is_user_input: False

            outputs:
                "loanId": string
                    description: "Loan identifier for internal reasoning only."
                    label: "Loan Id"
                    is_displayable: False
                    filter_from_agent: False
                "bookTitle": string
                    description: "Borrowed book title."
                    label: "Book Title"
                    is_displayable: True
                    filter_from_agent: False
                "borrowDate": string
