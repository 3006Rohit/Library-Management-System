                    filter_from_agent: False
                "status": string
                    description: "Loan lifecycle status."
                    label: "Status"
                    is_displayable: True
                    filter_from_agent: False
                "renewalCount": number
                    description: "Number of renewals used."
                    label: "Renewal Count"
                    is_displayable: True
                    filter_from_agent: False

        LibraryAgentMyReservationsAction:
            description: "Returns the authenticated member's own reservations for context when selecting a reservation to cancel."
            label: "Get My Reservations"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Loading your reservations"
            source: "LibraryAgentMyReservationsAction"
            target: "apex://LibraryAgentMyReservationsAction"

            inputs:
                "sessionToken": string
                    description: "Server-provided session binding. Never ask the member to type or reveal it."
                    label: "Session Token"
                    is_required: True
