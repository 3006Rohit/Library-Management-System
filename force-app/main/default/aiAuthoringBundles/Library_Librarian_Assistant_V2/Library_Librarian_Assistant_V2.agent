subagent Catalog_Search:
    label: "Catalog Search"
    description: "Use this topic when librarians need to search the public library catalog by title, author, category, or availability without accessing member-specific data."
    reasoning:
        instructions: ->
            | Your job is to only perform bounded searches in the public library catalog for titles, authors, categories, and availability. You cannot provide or expose member data.
              Additional instructions follow:
              If the query involves searching for books or materials by title, author, category, or availability, use LibraryAgentCatalogAction.

              Ensure the search is limited to public library catalog data.
        actions:
            LibraryAgentCatalogAction: @actions.LibraryAgentCatalogAction
                with author = ...
                with availableOnly = ...
                with category = ...
                with title = ...
    actions:
        LibraryAgentCatalogAction:
            description: "Searches the public library catalog by title, author, category, and availability without exposing member data."
            label: "Search Library Catalog"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Searching the library catalog"
            source: "LibraryAgentCatalogAction"
            target: "apex://LibraryAgentCatalogAction"
                                
            inputs:
                "author": string
                    description: "Optional author search text."
                    label: "Author"
                    is_required: False
                    is_user_input: False
                "availableOnly": boolean
                    description: "Return only books with available copies."
                    label: "Available Only"
                    is_required: False
                    is_user_input: False
                "category": string
                    description: "Optional category search text."
                    label: "Category"
                    is_required: False
                    is_user_input: False
                "title": string
                    description: "Optional title search text."
                    label: "Title"
                    is_required: False
                    is_user_input: False
                                
            outputs:
                "bookId": string
                    description: "Book record identifier for internal reasoning."
                    label: "Book Id"
                    is_displayable: False
                    filter_from_agent: False
                "title": string
                    description: "Book title."
                    label: "Title"
                    is_displayable: False
                    filter_from_agent: False
                "status": string
                    description: "Book status (Available, Unavailable, etc.)."
                    label: "Status"
                    is_displayable: False
                    filter_from_agent: False
                "totalCopies": number
                    description: "Total copies held by the library."
                    label: "Total Copies"
                    is_displayable: False
                    filter_from_agent: False
                "availableCopies": number
                    description: "Currently available copies."
                    label: "Available Copies"
                    is_displayable: False
                    filter_from_agent: False
                "message": string
                    description: "Error message when the catalog is temporarily unavailable."
                    label: "Message"
                    is_displayable: False
                    filter_from_agent: False
        AnswerQuestionsWithKnowledge:
            description: "Answers questions about company policies and procedures, troubleshooting steps, or product information. For example: “What is your return policy?” “How do I fix an issue?” or “What features does a product have?”"
            label: "Answer Questions with Knowledge"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Getting answers"
            source: "EmployeeCopilot__AnswerQuestionsWithKnowledge"
            target: "standardInvocableAction://streamKnowledgeSearch"
                                
            inputs:
                "query": string
                    description: "Required. A string created by generative AI to be used in the knowledge article search."
                    label: "Query"
                    is_required: True
                    is_user_input: True
                "citationsUrl": string = @knowledge.citations_url
                    description: "The URL to use for citations for custom Agents."
                    label: "Citations Url"
                    is_required: False
                    is_user_input: True
                "ragFeatureConfigId": string = @knowledge.rag_feature_config_id
                    description: "The RAG Feature ID to use for grounding this copilot action invocation."
                    label: "RAG Feature Configuration Id"
                    is_required: False
                    is_user_input: True
                "citationsEnabled": boolean = @knowledge.citations_enabled
                    description: "Whether or not citations are enabled."
                    label: "Citations Enabled"
                    is_required: False
                    is_user_input: True
                                
            outputs:
                "knowledgeSummary": object
                    description: "A string formatted as rich text that includes a summary of the information retrieved from the knowledge articles and citations to those articles."
                    label: "Knowledge Summary"
                    is_displayable: True
                    filter_from_agent: False
                    complex_data_type_name: "lightning__richTextType"
                "citationSources": object
