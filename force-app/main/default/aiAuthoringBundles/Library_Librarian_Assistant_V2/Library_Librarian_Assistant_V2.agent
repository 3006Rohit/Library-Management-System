subagent Member_Lookup:

    label: "Member Lookup"
    description: "Use this topic when librarians request a privacy-safe summary of an authorized member's information without exposing sensitive authentication or security details."

    reasoning:
        instructions: ->
            | Your job is to only provide authorized, privacy-safe summaries of selected members' information. Do not expose or process authentication details, security fields, or personal passwords.
              Additional instructions follow:
              If the request is for information about a specific member, use LibraryAgentMemberSummaryAction.
              
              Ensure that no authentication, security fields, or sensitive data is included in the response.
              
              

        actions:
            LibraryAgentMemberSummaryAction: @actions.LibraryAgentMemberSummaryAction
                with memberLookup = ...
            AnswerQuestionsWithKnowledge: @actions.AnswerQuestionsWithKnowledge
                with query = ...
                with citationsUrl = ...
                with ragFeatureConfigId = ...
                with citationsEnabled = False




