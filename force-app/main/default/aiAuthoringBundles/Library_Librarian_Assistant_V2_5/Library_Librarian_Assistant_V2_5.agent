system:
    instructions:|
        Act as a helpful conversational library assistant. Answer library-related questions naturally and directly. Use the matching read-only Apex action whenever the answer depends on current catalog, circulation, reservation, fine, copy, popularity, demand, or authorized member data. Preserve context across follow-up messages, including short replies such as yes, no, those, them, and how many. Never invent live library values, member facts, credentials, or security fields. Do not perform writes.
    messages:
        welcome:|
            Hi, I'm an AI assistant. How can I help you?
        error: "Sorry, it looks like something has gone wrong."

config:
    agent_label: "Library Librarian Assistant v2"
    agent_type: "AgentforceServiceAgent"
    company: "Library Management System"
    description: "You are a helpful library assistant for authorized librarians. Answer general library questions conversationally and use live read-only actions for current library data."
    developer_name: "Library_Librarian_Assistant_V2"
    role: "Act as a helpful conversational library assistant. Answer library-related questions naturally and directly. Use matching read-only actions for current data, preserve context across follow-ups, never invent live values or sensitive member data, and never perform writes."

access:
    default_agent_user: "library_librarian_assistant_v2@00dgk00000bjsnd1399459979.ext"

variables:
    VerifiedCustomerId: mutable string
        description: "This variable may also be referred to as VerifiedCustomerId"
        visibility: "Internal"
    ChannelType: linked string
        source: @MessagingSession.ChannelType
        description: "This variable may also be referred to as MessagingSession ChannelType"
    ContactId: linked string
        source: @MessagingEndUser.ContactId
        description: "This variable may also be referred to as MessagingEndUser ContactId"
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
        description: "This variable may also be referred to as MessagingEndUser Id"
    EndUserLanguage: linked string
        source: @MessagingSession.EndUserLanguage
        description: "This variable may also be referred to as MessagingSession EndUserLanguage"
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "This variable may also be referred to as MessagingSession Id"
    VoiceCallId: linked string
        source: @VoiceCall.Id
        description: "This variable may also be referred to as VoiceCall Id"

language:
    default_locale: "en_US"
    all_additional_locales: False
    adaptive: False

connection messaging:
    adaptive_response_allowed: True

connection customer_web_client:
    adaptive_response_allowed: True

knowledge:
    citations_enabled: False
    citations_url: ""
    rag_feature_config_id: ""

start_agent agent_router:

    label: "Agent Router"
    description: "Welcome the user and determine the appropriate subagent based on user input"

    reasoning:
        instructions: ->
            | Select the best tool or subagent based on the user's intent and conversation history. Preserve topic continuity across turns. Treat short replies such as yes, no, those, them, and how many as follow-ups to the previous library question. For any library-related question, choose the closest library subagent; only use off-topic handling when the request is clearly unrelated to library services. Do not route a library question to the ambiguous topic merely because it is short.

        actions:
            go_to_Library_Analytics: @utils.transition to @subagent.Library_Analytics
            go_to_Catalog_Search: @utils.transition to @subagent.Catalog_Search
            go_to_Member_Lookup: @utils.transition to @subagent.Member_Lookup
            go_to_Circulation_Information: @utils.transition to @subagent.Circulation_Information
            go_to_escalation: @utils.transition to @subagent.escalation
            go_to_ambiguous_question: @utils.transition to @subagent.ambiguous_question
            go_to_off_topic: @utils.transition to @subagent.off_topic

subagent Library_Analytics:

    label: "Library Analytics"
    description: "Use this topic when librarians request live aggregate data on library-wide metrics such as copy counts, loan statistics, reservation trends, fine totals, or item popularity."

    reasoning:
        instructions: ->
            | Provide live aggregate analytics related to library copies, loans, reservations, fines, popularity, and demand. Invoke LibraryAgentAnalyticsAction immediately for every current-value question, including follow-ups and short confirmations. Pass the current question or preserved prior question as requestContext. Do not ask for a time period unless the user explicitly requests one. You cannot modify data or provide member-specific details.
              Additional instructions follow:
              If the query is about library-wide metrics or analytics, use LibraryAgentAnalyticsAction.
              
              Ensure the request does not pertain to individual member data or require write operations.
              
              

        actions:
            LibraryAgentAnalyticsAction: @actions.LibraryAgentAnalyticsAction
                with requestContext = ...
            AnswerQuestionsWithKnowledge: @actions.AnswerQuestionsWithKnowledge
                with query = ...
                with citationsUrl = ...
                with ragFeatureConfigId = ...
                with citationsEnabled = False




    actions:
        LibraryAgentAnalyticsAction:
            description: "Returns bounded, read-only library-wide analytics for authorized librarians."
            label: "Get Library Analytics"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Loading library analytics"
            source: "LibraryAgentAnalyticsAction"
            target: "apex://LibraryAgentAnalyticsAction"
        
            inputs:
                "requestContext": string
                    description: "Optional context for a librarian analytics request."
                    label: "Request Context"
                    is_required: False
                    is_user_input: False
        
            outputs:
                "available": boolean
                    description: "Whether analytics data is available."
                    label: "Available"
                    is_displayable: False
                    filter_from_agent: False
                "message": string
                    description: "Status or error message from the analytics service."
                    label: "Message"
                    is_displayable: False
                    filter_from_agent: False
                "lastUpdated": string
                    description: "Timestamp of the last data refresh."
                    label: "Last Updated"
                    is_displayable: False
                    filter_from_agent: False
                "totalCopies": number
                    description: "Total copy count across all books."
                    label: "Total Copies"
                    is_displayable: False
                    filter_from_agent: False
                "availableCopies": number
                    description: "Total available copies ready to borrow."
                    label: "Available Copies"
                    is_displayable: False
                    filter_from_agent: False
                "borrowedCopies": number
                    description: "Total copies currently on loan."
                    label: "Borrowed Copies"
                    is_displayable: False
                    filter_from_agent: False
                "reservedCopies": number
                    description: "Total copies currently reserved."
                    label: "Reserved Copies"
                    is_displayable: False
                    filter_from_agent: False
                "lostCopies": number
                    description: "Total copies marked as lost."
                    label: "Lost Copies"
                    is_displayable: False
                    filter_from_agent: False
                "totalLoans": number
                    description: "Total governed loans."
                    label: "Total Loans"
                    is_displayable: False
                    filter_from_agent: False
                "activeLoans": number
                    description: "Active governed loans."
                    label: "Active Loans"
                    is_displayable: False
                    filter_from_agent: False
                "returnedLoans": number
                    description: "Returned governed loans."
                    label: "Returned Loans"
                    is_displayable: False
                    filter_from_agent: False
                "overdueLoans": number
                    description: "Overdue governed loans."
                    label: "Overdue Loans"
                    is_displayable: False
                    filter_from_agent: False
                "totalReservations": number
                    description: "Total governed reservations."
                    label: "Total Reservations"
                    is_displayable: False
                    filter_from_agent: False
                "fulfilledReservations": number
                    description: "Fulfilled governed reservations."
                    label: "Fulfilled Reservations"
                    is_displayable: False
                    filter_from_agent: False
                "cancelledReservations": number
                    description: "Cancelled governed reservations."
                    label: "Cancelled Reservations"
                    is_displayable: False
                    filter_from_agent: False
                "pendingReservations": number
                    description: "Pending governed reservations."
                    label: "Pending Reservations"
                    is_displayable: False
                    filter_from_agent: False
                "readyReservations": number
                    description: "Ready-to-collect governed reservations."
                    label: "Ready Reservations"
                    is_displayable: False
